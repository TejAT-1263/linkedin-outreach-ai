{
  "name": "linkedin-outreach-ai",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension: specific LinkedIn outreach notes, one-click insert, follow-up tracking.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-lines=100 --test-coverage-branches=95 --test-coverage-functions=95 \"tests/unit/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "check": "npm run lint && npm test && npm run test:e2e",
    "package": "node scripts/package.mjs",
    "test:fuzz": "FUZZ_N=5000 node --test tests/unit/fuzz.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.45.0"
  }
}
