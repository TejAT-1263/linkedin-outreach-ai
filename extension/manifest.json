{
  "manifest_version": 3,
  "name": "LinkedIn Outreach AI",
  "version": "3.3.1",
  "description": "Write short, specific LinkedIn notes from the profile you're viewing, insert them into LinkedIn, and never forget a follow-up.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage", "unlimitedStorage", "tabs", "scripting", "alarms", "notifications"],
  "host_permissions": ["https://www.linkedin.com/*", "https://api.anthropic.com/*", "https://api.openai.com/*"],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LinkedIn Outreach AI",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+O", "mac": "Alt+Shift+O" },
      "description": "Open LinkedIn Outreach AI"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
